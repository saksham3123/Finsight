PORT=5000
CORS_ORIGIN=http://localhost:5173

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE (URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/finsight

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# Access-token lifetime (jsonwebtoken format) and refresh-token lifetime in days
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# Shared secret the ML service sends in the X-Service-Key header to push prices, advisories and news
ML_SERVICE_KEY=replace_with_another_long_random_string

# How often the in-process scheduler runs due SIPs (0 disables it; use npm run sips:run instead)
SIP_SCHEDULER_INTERVAL_MINUTES=60

# Used only by npm run seed to create or update the admin account
ADMIN_EMAIL=admin@finsight.local
ADMIN_PASSWORD=choose_a_strong_password

# Separate database for npm test. It is wiped on every run, so the name must end in _test.
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/finsight_test
