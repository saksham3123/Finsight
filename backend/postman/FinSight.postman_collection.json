            "body": {
              "mode": "raw",
              "raw": "{\n  \"theme\": \"dark\",\n  \"lastRoute\": \"/portfolio\",\n  \"uiState\": {\n    \"chartRange\": \"1y\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
